---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useLocale } from '../i18n';

interface Props {
	title?: string;
	description?: string;
}

const siteName = 'Evolving Machines Lab';
const { t, language, isZh, alternate } = useLocale(Astro.url);
const siteDescription = t('Evolving Machines Lab researches AI agents that learn and evolve across digital and physical worlds through interaction, reinforcement learning, and experience.');
const { title = siteName, description = siteDescription } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = new URL(base.replace(/\/?$/, '/'), Astro.site).href;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), Astro.site);
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const organizationId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ResearchOrganization',
			'@id': organizationId,
			name: siteName,
			url: siteUrl,
			description: siteDescription,
			logo: new URL(`${base}favicon.svg`, Astro.site).href,
			founder: { '@type': 'Person', name: 'Zaibin Zhang', url: 'https://zhangzaibin.github.io/' },
		},
		{
			'@type': 'WebSite',
			'@id': websiteId,
			name: siteName,
			url: siteUrl,
			description: siteDescription,
			inLanguage: ['en', 'zh-CN'],
			publisher: { '@id': organizationId },
		},
		{
			'@type': 'WebPage',
			'@id': `${canonical.href}#webpage`,
			name: fullTitle,
			url: canonical.href,
			description,
			inLanguage: language,
			isPartOf: { '@id': websiteId },
			about: { '@id': organizationId },
		},
	],
};
---

<!doctype html>
<html lang={language}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="application-name" content={siteName} />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href={new URL(alternate('en'), Astro.site)} />
		<link rel="alternate" hreflang="zh-CN" href={new URL(alternate('zh'), Astro.site)} />
		<link rel="alternate" hreflang="x-default" href={new URL(alternate('en'), Astro.site)} />
		<link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<meta name="theme-color" content="#f8f7f4" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={isZh ? 'zh_CN' : 'en_US'} />
		<meta property="og:locale:alternate" content={isZh ? 'en_US' : 'zh_CN'} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(`${base}og.svg`, Astro.site)} />
		<meta property="og:image:alt" content={isZh ? `${siteName} — 让智能在交互中持续成长` : `${siteName} — building intelligence that grows through interaction`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<title>{fullTitle}</title>
		<script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
	</head>
	<body>
		<a class="skip" href="#content">{t('Skip to content')}</a>
		<Header />
		<main id="content" class="page"><slot /></main>
		<Footer />
	</body>
</html>

<style>
	.skip {
		position: fixed; left: 1rem; top: 1rem; z-index: 1000; transform: translateY(-200%);
		padding: .75rem 1rem; background: var(--ink); color: var(--paper);
	}
	.skip:focus { transform: translateY(0); }
</style>
