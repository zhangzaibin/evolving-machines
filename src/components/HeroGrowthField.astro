---
// A deterministic point field, rendered without a canvas loop or client runtime.
const points = Array.from({ length: 1800 }, (_, i) => {
	const y = 1 - (i / 1799) * 2;
	const radius = Math.sqrt(1 - y * y);
	const angle = i * Math.PI * (3 - Math.sqrt(5));
	const x = Math.cos(angle) * radius;
	const z = Math.sin(angle) * radius;
	const twist = y * .55;
	const rotatedX = x * Math.cos(twist) - z * Math.sin(twist);
	const rotatedZ = x * Math.sin(twist) + z * Math.cos(twist);
	const scale = 1 + rotatedZ * .12;
	return { x: 280 + rotatedX * 191 * scale, y: 270 + y * 191 * scale,
		r: .7 + (rotatedZ + 1) * .65, opacity: .18 + (rotatedZ + 1) * .36,
		color: rotatedX + y * .45 > .05 ? '#bd674b' : '#414940', z: rotatedZ };
}).sort((a, b) => a.z - b.z);
---

<div class="growth" aria-hidden="true">
	<div class="field-label"><span class="live-dot"></span> An open-ended evolution</div>
	<svg class="field" viewBox="0 0 560 540" fill="none">
		<path class="guide" d="M280 22V518M30 270H530" stroke-dasharray="2 7" />
		<circle class="guide" cx="280" cy="270" r="222" stroke-dasharray="2 7" />
		<g class="sphere">{points.map((p) => <circle cx={p.x} cy={p.y} r={p.r} fill={p.color} opacity={p.opacity} />)}</g>
		<ellipse class="orbit" cx="280" cy="270" rx="246" ry="77" transform="rotate(-29 280 270)" />
		<circle cx="495" cy="151" r="4" fill="var(--acid)" />
		<circle cx="65" cy="389" r="3" fill="var(--ink)" />
		<path class="ticks" d="M280 43v10M280 487v10M53 270h10M497 270h10" />
	</svg>
	<div class="field-caption"><span>Interaction → adaptation</span><span>EML / 001</span></div>
</div>

<style>
	.growth { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; }
	.field-label, .field-caption { display: flex; align-items: center; font: .58rem/1.5 var(--mono); letter-spacing: .07em; text-transform: uppercase; color: var(--muted); }
	.field-label { gap: .5rem; padding-left: 1.5rem; }
	.live-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--acid); }
	.field { width: 100%; height: auto; overflow: visible; }
	.guide { stroke: var(--line); stroke-width: .7; }
	.orbit { stroke: var(--acid); stroke-width: .7; opacity: .55; }
	.ticks { stroke: var(--muted); stroke-width: .8; }
	.sphere { transform-origin: 280px 270px; animation: breathe 16s ease-in-out infinite; }
	.field-caption { justify-content: space-between; padding: 0 1.5rem; }
	@keyframes breathe { 50% { transform: rotate(7deg) scale(.98); } }
</style>
