---
interface Props {
	project: {
		name: string;
		kicker: string;
		tagline: string;
		description: string;
		metrics: string[];
		links: Record<string, string>;
		image?: string;
		modules?: {
			name: string;
			description: string;
			status: 'Open Source' | 'Coming Soon';
		}[];
	};
	index: number;
	large?: boolean;
}
const { project, index, large = false } = Astro.props;
const variant = (index - 1) % 3;
---

<article class:list={['feature', { large }]} data-variant={variant}>
	<div class="visual">
		<div class="visual-label">{String(index).padStart(2, '0')} / {project.kicker}</div>
		<svg class="diagram" viewBox="0 0 700 480" aria-hidden="true">
			<defs>
				<pattern id={`grid-${index}`} width="40" height="40" patternUnits="userSpaceOnUse">
					<path d="M40 0H0V40" fill="none" stroke="currentColor" stroke-width=".6" opacity=".16" />
				</pattern>
			</defs>
			<rect width="700" height="480" fill={`url(#grid-${index})`} />
			{variant === 0 && (
				<g class="network">
					<circle class="orbit" cx="350" cy="242" r="145" />
					<circle class="orbit faint" cx="350" cy="242" r="90" />
					<path d="M350 242L235 154M350 242l148-65M350 242l112 132M350 242l-158 88M235 154l263 23M192 330l270 44" />
					<circle class="signal core" cx="350" cy="242" r="24" />
					<circle class="node" cx="235" cy="154" r="10" />
					<circle class="node" cx="498" cy="177" r="15" />
					<circle class="node" cx="462" cy="374" r="9" />
					<circle class="node" cx="192" cy="330" r="13" />
					<circle class="node signal" cx="350" cy="97" r="7" />
				</g>
			)}
			{variant === 1 && (
				<g class="modules">
					<path d="M105 240h105m120 0h90m120 0h55M270 150v-48m0 276v-48M480 150v-48m0 276v-48" />
					<rect x="210" y="150" width="120" height="180" rx="60" />
					<rect x="420" y="150" width="120" height="180" rx="60" />
					<circle class="signal" cx="270" cy="240" r="24" />
					<circle class="node" cx="480" cy="240" r="24" />
					<circle class="node" cx="105" cy="240" r="10" />
					<circle class="signal" cx="595" cy="240" r="10" />
					<circle class="node" cx="270" cy="102" r="7" />
					<circle class="node" cx="270" cy="378" r="7" />
					<circle class="node" cx="480" cy="102" r="7" />
					<circle class="node" cx="480" cy="378" r="7" />
				</g>
			)}
			{variant === 2 && (
				<g class="motion">
					<path class="sweep" d="M102 356C196 97 439 62 604 207" />
					<path class="sweep faint" d="M102 356c168 34 344-13 502-149" />
					<path d="M102 356l104-34 88-96 115 20 88-101 107 62" />
					<circle class="signal" cx="102" cy="356" r="14" />
					<circle class="node" cx="206" cy="322" r="8" />
					<circle class="node" cx="294" cy="226" r="12" />
					<circle class="signal" cx="409" cy="246" r="18" />
					<circle class="node" cx="497" cy="145" r="9" />
					<circle class="node" cx="604" cy="207" r="14" />
				</g>
			)}
		</svg>
		<span class="diagram-code">EML / SYSTEM {String(index).padStart(2, '0')}</span>
	</div>
	<div class="body">
		<p class="eyebrow">{project.kicker}</p>
		<h3>{project.name}</h3>
		<p class="tagline">{project.tagline}</p>
		<p class="description">{project.description}</p>
		{project.modules && (
			<div class="modules-list" aria-label={`${project.name} initiatives`}>
				{project.modules.map((module) => (
					<div class="module">
						<div>
							<strong>{module.name}</strong>
							<p>{module.description}</p>
						</div>
						<span class:list={['status', { soon: module.status === 'Coming Soon' }]}>{module.status}</span>
					</div>
				))}
			</div>
		)}
		<ul>{project.metrics.map((item) => <li>{item}</li>)}</ul>
		<div class="links">
			{Object.entries(project.links).map(([label, url]) => <a href={url} target="_blank">{label} <span class="arrow">↗</span></a>)}
		</div>
	</div>
</article>

<style>
	.feature { display: grid; grid-template-columns: 1fr 1fr; min-height: 29rem; border: 1px solid var(--line); background: var(--paper); }
	.feature + .feature { margin-top: 1.25rem; }
	.feature[data-variant="1"] .visual { order: 2; border-right: 0; border-left: 1px solid var(--line); }
	.visual { position: relative; min-height: 27rem; overflow: hidden; background: var(--paper-soft); border-right: 1px solid var(--line); }
	.visual::after { content: ""; position: absolute; width: 14rem; height: 14rem; right: -5rem; bottom: -6rem; border-radius: 50%; background: color-mix(in srgb, var(--acid) 56%, transparent); filter: blur(10px); }
	.diagram { position: absolute; inset: 8% 4% 4%; width: 92%; height: 88%; color: var(--ink); transition: transform .7s cubic-bezier(.2,.7,.2,1); }
	.diagram g > path, .diagram .orbit, .diagram g > rect { fill: none; stroke: currentColor; stroke-width: 1.1; vector-effect: non-scaling-stroke; }
	.diagram .orbit { stroke-dasharray: 4 8; }
	.diagram .faint { opacity: .28; }
	.diagram .node { fill: var(--paper); stroke: var(--ink); stroke-width: 1.5; }
	.diagram .signal { fill: var(--acid); stroke: var(--ink); stroke-width: 1.5; }
	.diagram .core { transform-origin: 350px 242px; transition: transform .5s ease; }
	.diagram .sweep { stroke-dasharray: 3 8; }
	.feature:hover .diagram { transform: scale(1.025); }
	.feature:hover .diagram .core { transform: scale(1.3); }
	.diagram-code { position: absolute; left: 1.2rem; bottom: 1rem; font: .58rem var(--mono); letter-spacing: .08em; color: var(--muted); }
	.visual-label { position: absolute; z-index: 2; left: 1rem; top: 1rem; padding: .42rem .6rem; background: color-mix(in srgb, var(--paper) 88%, transparent); border: 1px solid var(--line-strong); font: .58rem var(--mono); letter-spacing: .04em; text-transform: uppercase; backdrop-filter: blur(8px); }
	.body { padding: clamp(2rem, 3.5vw, 3.5rem); display: flex; flex-direction: column; justify-content: center; }
	h3 { margin: 0; font-size: clamp(3rem, 4.7vw, 4.7rem); line-height: .9; letter-spacing: -.06em; font-weight: 500; }
	.tagline { margin: 1.5rem 0 .8rem; font-size: clamp(1.1rem, 1.5vw, 1.3rem); line-height: 1.25; letter-spacing: -.025em; }
	.description { margin: 0; color: var(--muted); max-width: 35rem; font-size: .95rem; }
	.modules-list { margin-top: 1.5rem; border-top: 1px solid var(--line); }
	.module { display: grid; grid-template-columns: 1fr auto; gap: 1.25rem; padding: .8rem 0; border-bottom: 1px solid var(--line); align-items: start; }
	.module strong { font-size: .92rem; font-weight: 650; letter-spacing: -.02em; }
	.module p { margin: .2rem 0 0; max-width: 29rem; color: var(--muted); font-size: .78rem; line-height: 1.4; }
	.status { padding: .35rem .55rem; border: 1px solid var(--ink); border-radius: 2rem; font: .56rem var(--mono); letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
	.status.soon { border-color: var(--line); color: var(--muted); }
	ul { display: flex; flex-wrap: wrap; gap: .4rem; list-style: none; padding: 0; margin: 1.5rem 0; }
	li { padding: .32rem .5rem; border: 1px solid var(--line); border-radius: 2rem; font: .58rem var(--mono); text-transform: uppercase; }
	.links { display: flex; gap: 1.5rem; font: .64rem var(--mono); letter-spacing: .04em; text-transform: uppercase; }
	@media (max-width: 800px) {
		.feature { grid-template-columns: 1fr; }
		.feature[data-variant="1"] .visual { order: 0; border-left: 0; }
		.visual { min-height: 20rem; border-right: 0; border-bottom: 1px solid var(--line); }
	}
</style>
