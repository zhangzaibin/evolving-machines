---
const links = [
	['Research', '/research'],
	['Projects', '/projects'],
	['Publications', '/publications'],
	['News', '/news'],
];
const base = import.meta.env.BASE_URL;
const to = (href: string) => `${base}${href.replace(/^\//, '')}`;
const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="shell nav-wrap">
		<a class="brand" href={base} aria-label="Evolving Machines Lab home">
			<svg viewBox="0 0 32 32" role="img" aria-hidden="true">
				<path d="M5 25V8l11 9L27 6v19" />
				<circle cx="5" cy="8" r="2.5" /><circle cx="16" cy="17" r="2.5" /><circle cx="27" cy="6" r="2.5" /><circle cx="27" cy="25" r="2.5" />
			</svg>
			<span>Evolving<br />Machines Lab</span>
		</a>
		<button class="menu" aria-expanded="false" aria-controls="navigation">Menu</button>
		<nav id="navigation" aria-label="Main navigation">
			{links.map(([label, href]) => (
				<a href={to(href)} aria-current={path.startsWith(to(href)) ? 'page' : undefined}>{label}</a>
			))}
		</nav>
	</div>
</header>

<script>
	const menu = document.querySelector<HTMLButtonElement>('.menu');
	const nav = document.querySelector<HTMLElement>('#navigation');
	menu?.addEventListener('click', () => {
		const open = menu.getAttribute('aria-expanded') === 'true';
		menu.setAttribute('aria-expanded', String(!open));
		nav?.toggleAttribute('data-open', !open);
	});
</script>

<style>
	.site-header { position: sticky; top: 0; z-index: 50; height: 84px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 91%, transparent); backdrop-filter: blur(16px); }
	.nav-wrap { height: 100%; display: flex; align-items: center; justify-content: space-between; }
	.brand { display: flex; align-items: center; gap: .8rem; font-size: .79rem; font-weight: 600; line-height: .94; letter-spacing: -.02em; }
	.brand svg { width: 31px; height: 31px; overflow: visible; }
	.brand path { fill: none; stroke: var(--ink); stroke-width: 1.4; }
	.brand circle { fill: var(--acid); stroke: var(--ink); stroke-width: 1.3; }
	nav { display: flex; align-items: center; gap: clamp(1.2rem, 2.5vw, 2.8rem); }
	nav a { font: .68rem var(--mono); text-transform: uppercase; letter-spacing: .08em; }
	nav a[aria-current="page"]::after { content: ""; display: block; height: 2px; margin-top: .35rem; background: var(--ink); }
	.menu { display: none; border: 0; background: none; font: .7rem var(--mono); text-transform: uppercase; }
	@media (max-width: 760px) {
		.menu { display: block; }
		nav { display: none; position: absolute; inset: 84px 0 auto; padding: 2rem var(--pad); background: var(--paper); border-bottom: 1px solid var(--line); flex-direction: column; align-items: flex-start; }
		nav[data-open] { display: flex; }
	}
</style>
