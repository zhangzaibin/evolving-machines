---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const areas = [
	{
		n: '01', name: 'Digital World', question: 'How does intelligence grow through digital interaction?',
		approach: 'The digital world gives agents a scalable environment for communication, social interaction, and rapid experimentation. OASIS lets us observe how behavior and intelligence change across populations of up to one million agents.',
		systems: [{ name: 'OASIS', id: 'oasis' }],
		lens: 'Agents · Societies · Simulation'
	},
	{
		n: '02', name: 'Physical World', question: 'How can intelligence become reliable physical action?',
		approach: 'The physical world grounds learning in space, bodies, and consequence. SPAgent connects multimodal reasoning to spatial tools, while Future develops compositional policies, benchmarks, and hardware infrastructure for embodied evolution.',
		systems: [{ name: 'SPAgent', id: 'spagent' }, { name: 'Future', id: 'future' }],
		lens: 'Space · Bodies · Action'
	},
];
const methods = [
	['01', 'Interaction', 'Generate experience by acting with agents, societies, tools, and the world.'],
	['02', 'Reinforcement Learning', 'Turn environmental and social feedback into better decisions over time.'],
	['03', 'Self-Evolution', 'Create new learning signals, curricula, and capabilities from the system’s own experience.'],
	['04', 'Compositional Generalization', 'Reuse and recombine learned skills to solve situations not seen during training.'],
];
---

<BaseLayout title="Research" description="Evolving Machines Lab studies intelligence across the digital world and physical world.">
	<header class="page-hero shell">
		<p class="eyebrow">Research</p>
		<h1 class="display">Intelligence is<br />a <em>process.</em></h1>
		<p class="lede">Digital and physical worlds are the environments. Evolution is the method: interaction creates experience, reinforcement turns feedback into learning, and composition carries learning into new situations.</p>
	</header>

	<section class="section methodology">
		<div class="shell">
			<div class="method-head">
				<div><p class="eyebrow">How machines evolve</p><h2>One learning loop,<br /><em>across both worlds.</em></h2></div>
				<p>Our projects differ in scale and embodiment, but share a common mechanism: intelligence must keep changing through its consequences rather than remain fixed after training.</p>
			</div>
			<div class="method-grid">
				{methods.map(([index, name, description]) => (
					<article>
						<span>{index}</span>
						<h3>{name}</h3>
						<p>{description}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<div class="areas">
		{areas.map((area) => (
			<section class="area section">
				<div class="shell area-grid">
					<div class="area-index"><span>{area.n}</span><span>{area.lens}</span></div>
					<div class="area-main">
						<p class="eyebrow">{area.name}</p>
						<h2>{area.question}</h2>
						<p>{area.approach}</p>
					</div>
					<div class="systems">
						<span class="mono">Systems / Papers</span>
						{area.systems.map((system) => <a href={`${base}projects#${system.id}`}>{system.name} <span class="arrow">↗</span></a>)}
					</div>
				</div>
			</section>
		))}
	</div>

	<section class="section principle">
		<div class="shell">
			<p class="eyebrow">A unifying principle</p>
			<p>Evolution is the loop between <em>agent</em>, <em>experience</em>, and <em>world</em>.</p>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero em { font-family: var(--serif); font-weight: 400; }
	.methodology { background: var(--paper-soft); }
	.method-head { display: grid; grid-template-columns: 1.35fr .65fr; gap: clamp(3rem, 8vw, 8rem); align-items: end; margin-bottom: clamp(3rem, 6vw, 5rem); }
	.method-head h2 { margin: 0; font-size: clamp(3rem, 5.5vw, 5.5rem); line-height: .95; letter-spacing: -.055em; font-weight: 450; }
	.method-head h2 em { font-family: var(--serif); font-weight: 400; color: var(--acid-deep); }
	.method-head > p { max-width: 31rem; margin: 0; color: var(--muted); font-size: 1.05rem; }
	.method-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line-strong); border-left: 1px solid var(--line-strong); }
	.method-grid article { min-height: 18rem; padding: 1.5rem; border-right: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); display: flex; flex-direction: column; }
	.method-grid span { color: var(--muted); font: .6rem var(--mono); }
	.method-grid h3 { margin: auto 0 1rem; font-size: clamp(1.3rem, 2vw, 1.8rem); line-height: 1.05; letter-spacing: -.04em; font-weight: 550; }
	.method-grid p { min-height: 5rem; margin: 0; color: var(--muted); font-size: .88rem; }
	.area-grid { display: grid; grid-template-columns: 1fr 2.4fr 1fr; gap: clamp(2rem, 5vw, 6rem); }
	.area-index { display: flex; flex-direction: column; justify-content: space-between; min-height: 23rem; font: .62rem/1.4 var(--mono); text-transform: uppercase; color: var(--muted); }
	.area-index span:last-child { max-width: 9rem; }
	.area-main h2 { margin: 0; max-width: 760px; font-size: clamp(2.6rem, 4.5vw, 4.7rem); line-height: .98; letter-spacing: -.05em; font-weight: 450; }
	.area-main > p:last-child { max-width: 46rem; margin-top: 2rem; color: var(--muted); font-size: 1.05rem; }
	.systems { display: flex; flex-direction: column; gap: .75rem; }
	.systems > span { margin-bottom: 1rem; color: var(--muted); font-size: .62rem; text-transform: uppercase; }
	.systems a { padding-bottom: .7rem; border-bottom: 1px solid var(--line); }
	.principle p:last-child { max-width: 1050px; margin: 0; font-size: clamp(2.8rem, 5.5vw, 5.7rem); line-height: .98; letter-spacing: -.055em; }
	.principle em { font-family: var(--serif); font-weight: 400; color: var(--acid-deep); }
	@media (max-width: 800px) {
		.method-head { grid-template-columns: 1fr; }
		.method-grid { grid-template-columns: 1fr 1fr; }
		.area-grid { grid-template-columns: 1fr; }
		.area-index { min-height: auto; flex-direction: row; }
	}
	@media (max-width: 520px) {
		.method-grid { grid-template-columns: 1fr; }
		.method-grid article { min-height: 14rem; }
	}
</style>
