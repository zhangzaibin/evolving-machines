---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import PublicationList from '../components/PublicationList.astro';
import EvolutionFramework from '../components/EvolutionFramework.astro';
import HeroGrowthField from '../components/HeroGrowthField.astro';

const allProjects = await getCollection('projects');
const base = import.meta.env.BASE_URL;
const publicationOrder = ['oasis', 'psysafe', 'think3d', 'ma-vla', 'attention-dp3', 'comas', 'agentic-rl'];
const publications = await getCollection('publications');
const allPubs = publicationOrder.map((id) => publications.find((publication) => publication.id === id)!).filter(Boolean);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const flagshipIds = ['oasis', 'spagent', 'future'];
const flagships = flagshipIds.map((id) => allProjects.find((project) => project.id === id)!).filter(Boolean);
---

<BaseLayout>
	<section class="hero shell">
		<div class="hero-copy">
			<p class="eyebrow">Digital intelligence · Embodied intelligence</p>
			<h1 class="display">Evolving <em>Machines</em> Lab</h1>
			<p class="hero-line">How can agents keep evolving—across digital and physical worlds?</p>
			<p class="lab-note">We are a group of passionate researchers from institutions including Dalian University of Technology and the University of Oxford. Our team members received an ACL 2024 Outstanding Paper Award, and our open-source projects have earned over 5,000 GitHub stars, establishing worldwide recognition in agent research.</p>
			<div class="hero-actions">
				<a href="#evolution">See how we evolve <span class="arrow">↓</span></a>
				<a href={`${base}projects`}>Explore systems <span class="arrow">↗</span></a>
			</div>
		</div>
		<div class="hero-visual"><HeroGrowthField /></div>
	</section>

	<section class="about section">
		<div class="shell">
			<div class="about-copy">
				<p class="eyebrow">About the lab</p>
				<p>We build agents that do more than execute. They <em>act</em>, gather experience, and become more capable in the worlds they inhabit.</p>
			</div>
		</div>
	</section>

	<section class="section worlds" id="evolution">
		<div class="shell">
			<EvolutionFramework />
		</div>
	</section>

	<section class="section projects">
		<div class="shell">
			<div class="section-head compact">
				<div><h2 class="display">Projects.</h2></div>
				<a class="all-link" href={`${base}projects`}>All projects <span class="arrow">↗</span></a>
			</div>
			{flagships.map((project, index) => <ProjectFeature project={project.data} index={index + 1} />)}
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-head compact">
				<div><h2 class="display">Research.</h2></div>
				<a class="all-link" href={`${base}publications`}>Full index <span class="arrow">↗</span></a>
			</div>
			<PublicationList publications={allPubs} />
		</div>
	</section>

	<section class="section institutions">
		<div class="shell">
			<h2 class="institution-intro">Institutions.</h2>
			<div class="institution-grid">
				<a href="https://www.dlut.edu.cn/" target="_blank"><span>01 / Dalian, CN</span><strong>Dalian University<br />of Technology</strong><span class="arrow">↗</span></a>
				<a href="https://www.ox.ac.uk/" target="_blank"><span>02 / Oxford, UK</span><strong>University<br />of Oxford</strong><span class="arrow">↗</span></a>
				<a href="https://www.kaust.edu.sa/" target="_blank"><span>03 / Thuwal, SA</span><strong>KAUST</strong><span class="arrow">↗</span></a>
				<a href="https://ucsd.edu/" target="_blank"><span>04 / California, US</span><strong>UC San<br />Diego</strong><span class="arrow">↗</span></a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-head compact">
				<div><h2 class="display">News.</h2></div>
				<a class="all-link" href={`${base}news`}>All news <span class="arrow">↗</span></a>
			</div>
			<div class="grid-3 card-grid">
				{news.map((item) => (
					<a class="card news-card" href={item.data.link ?? `${base}news`}>
						<span class="index">{item.data.date.toLocaleDateString('en', { month: 'short', year: 'numeric' })}</span>
						<h3>{item.data.title}</h3><p>{item.data.description}</p>
						<span class="link-row">Read <span class="arrow">↗</span></span>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero { min-height: calc(92svh - 72px); display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 5vw, 6rem); align-items: center; padding-block: clamp(4rem, 7vw, 7rem); }
	.hero-copy { width: 100%; }
	.hero h1 { max-width: 100%; font-size: clamp(4rem, 7.7vw, 8rem); }
	.hero h1 em { font-family: var(--serif); font-weight: 400; }
	.hero .eyebrow { margin-bottom: 2rem; }
	.hero-line { max-width: 43rem; margin: clamp(2.5rem, 5vw, 4.5rem) 0 0; font-size: clamp(1.2rem, 2vw, 1.75rem); line-height: 1.2; letter-spacing: -.03em; }
	.lab-note { max-width: 41rem; margin: .75rem 0 0; color: var(--muted); font-size: .78rem; }
	.hero-actions { display: flex; gap: 2rem; margin-top: 2rem; font: .65rem var(--mono); text-transform: uppercase; letter-spacing: .04em; }
	.hero-actions a:first-child { padding-bottom: .35rem; border-bottom: 1px solid var(--ink); }
	.hero-visual { min-width: 0; height: clamp(28rem, 54vw, 44rem); }
	.about-copy { display: grid; grid-template-columns: .35fr 1.65fr; gap: 3rem; align-items: start; }
	.about-copy > p:last-child { max-width: 1040px; margin: 0; font-size: clamp(2.4rem, 5vw, 5.1rem); line-height: 1; letter-spacing: -.055em; }
	.about-copy em { font-family: var(--serif); font-weight: 400; color: var(--acid-deep); }
	.section-head { display: grid; grid-template-columns: 1.2fr .8fr; gap: 4rem; align-items: end; margin-bottom: clamp(3.5rem, 6vw, 6rem); }
	.section-head h2 { font-size: clamp(3rem, 5.8vw, 5.8rem); }
	.section-head.compact { grid-template-columns: 1fr auto; }
	.all-link { align-self: end; padding-bottom: .35rem; border-bottom: 1px solid var(--ink); font: .68rem var(--mono); text-transform: uppercase; }
	.institution-intro { margin: 0 0 clamp(3rem, 5vw, 5rem); font-size: clamp(2.8rem, 5.5vw, 5.5rem); line-height: .95; letter-spacing: -.055em; font-weight: 450; }
	.institution-intro em { font-family: var(--serif); font-weight: 400; }
	.institution-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
	.institution-grid a { min-height: 14rem; padding: 1.5rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; transition: background .25s ease; }
	.institution-grid a:hover { background: var(--acid); }
	.institution-grid span { font: .62rem var(--mono); text-transform: uppercase; color: var(--muted); }
	.institution-grid .arrow { align-self: flex-end; color: var(--ink); }
	.institution-grid strong { font-size: clamp(1.2rem, 1.7vw, 1.75rem); line-height: 1.05; letter-spacing: -.04em; font-weight: 500; }
	@media (max-width: 800px) {
		.hero { min-height: auto; grid-template-columns: 1fr; padding-block: 6rem; }
		.hero h1 { white-space: normal; }
		.hero-visual { height: 22rem; }
		.about-copy { grid-template-columns: 1fr; gap: 1rem; }
		.section-head, .section-head.compact { grid-template-columns: 1fr; gap: 2rem; }
		.all-link { justify-self: start; }
		.institution-grid { grid-template-columns: repeat(2, 1fr); }
	}
</style>
