---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import PublicationList from '../components/PublicationList.astro';
import EvolutionFramework from '../components/EvolutionFramework.astro';
import HeroGrowthField from '../components/HeroGrowthField.astro';

const allProjects = await getCollection('projects');
const base = import.meta.env.BASE_URL;
const publicationOrder = ['oasis', 'psysafe', 'think3d', 'ma-vla', 'attention-dp3', 'comas', 'agentic-rl'];
const publications = await getCollection('publications');
const allPubs = publicationOrder.map((id) => publications.find((publication) => publication.id === id)!).filter(Boolean);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const flagshipIds = ['oasis', 'spagent', 'future'];
const flagships = flagshipIds.map((id) => allProjects.find((project) => project.id === id)!).filter(Boolean);
---

<BaseLayout>
	<section class="hero shell">
		<div class="hero-copy">
			<p class="eyebrow">Digital intelligence · Embodied intelligence</p>
			<h1 class="display">Evolving <br />Machines Lab<span>.</span></h1>
			<p class="hero-line">Building intelligence that learns, adapts,<br class="desktop-break" /> and evolves with the world.</p>
			<div class="hero-actions">
				<a class="button" href="#evolution">Explore our research <span class="arrow">↗</span></a>
				<a class="text-link" href={`${base}projects`}>Our open systems <span class="arrow">→</span></a>
			</div>
		</div>
		<div class="hero-visual"><HeroGrowthField /></div>
	</section>

	<div class="shell">
		<div class="hero-foot"><span>Research across two worlds</span><div><span>01 / Digital intelligence</span><span>02 / Embodied intelligence</span></div><a href="#about" aria-label="Discover the lab">↓</a></div>
	</div>

	<section class="about section" id="about">
		<div class="shell">
			<div class="about-copy">
				<p class="eyebrow">About the lab</p>
				<div>
					<h2>Intelligence is not a fixed state.<br />It is a process of <em>becoming.</em></h2>
					<div class="about-detail"><p>We build agents that act, gather experience, and become more capable in the worlds they inhabit. Our research connects digital societies with physical intelligence through a shared idea: learning never stops.</p><p>Evolving Machines Lab brings together researchers from institutions including Dalian University of Technology, the University of Oxford, KAUST, and UCSD to advance open, continually evolving intelligence.</p></div>
					<div class="lab-facts"><div><strong>5,000+</strong><span>Open-source GitHub stars</span></div><div><strong>Outstanding Paper Award</strong><span>Top AI Conference</span></div></div>
				</div>
			</div>
		</div>
	</section>

	<section class="section worlds" id="evolution">
		<div class="shell">
			<EvolutionFramework />
		</div>
	</section>

	<section class="section projects">
		<div class="shell">
			<div class="section-head compact">
				<div><p class="eyebrow">Built in the open</p><h2 class="display">Research into reality.</h2></div>
				<a class="text-link all-link" href={`${base}projects`}>All projects <span class="arrow">↗</span></a>
			</div>
			<div class="grid-3 project-grid">{flagships.map((project, index) => <ProjectFeature project={project.data} index={index + 1} compact />)}</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-head compact">
				<div><p class="eyebrow">Selected publications</p><h2 class="display">Ideas in motion.</h2></div>
				<a class="text-link all-link" href={`${base}publications`}>Full index <span class="arrow">↗</span></a>
			</div>
			<PublicationList publications={allPubs} limit={4} />
		</div>
	</section>

	<section class="section institutions">
		<div class="shell">
			<p class="eyebrow">Our research community</p><h2 class="institution-intro">Connected by curiosity.</h2>
			<div class="institution-grid">
				<a href="https://www.dlut.edu.cn/" target="_blank"><span>01 / Dalian, CN</span><strong>Dalian University<br />of Technology</strong><span class="arrow">↗</span></a>
				<a href="https://www.ox.ac.uk/" target="_blank"><span>02 / Oxford, UK</span><strong>University<br />of Oxford</strong><span class="arrow">↗</span></a>
				<a href="https://www.kaust.edu.sa/" target="_blank"><span>03 / Thuwal, SA</span><strong>KAUST</strong><span class="arrow">↗</span></a>
				<a href="https://ucsd.edu/" target="_blank"><span>04 / California, US</span><strong>UC San<br />Diego</strong><span class="arrow">↗</span></a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			<div class="section-head compact">
				<div><p class="eyebrow">From the lab</p><h2 class="display">The latest.</h2></div>
				<a class="text-link all-link" href={`${base}news`}>All news <span class="arrow">↗</span></a>
			</div>
			<div class="grid-3 card-grid">
				{news.map((item) => (
					<a class="card news-card" href={item.data.link ?? `${base}news`}>
						<span class="index">{item.data.date.toLocaleDateString('en', { month: 'short', year: 'numeric' })}</span>
						<h3>{item.data.title}</h3><p>{item.data.description}</p>
						<span class="link-row">Read <span class="arrow">↗</span></span>
					</a>
				))}
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.hero { min-height: 640px; display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 4vw, 4rem); align-items: center; padding-block: clamp(3rem, 5vw, 5rem); }
	.hero-copy { min-width: 0; padding-bottom: 1rem; }
	.hero h1 { font-size: clamp(3.25rem, 5.85vw, 5.4rem); letter-spacing: -.06em; line-height: 1.07; white-space: nowrap; }
	.hero h1 span { color: var(--acid); }
	.hero .eyebrow { margin-bottom: 2.25rem; font-size: .62rem; }
	.hero-line { margin: 1.75rem 0 0; color: var(--muted); font-size: clamp(1.1rem, 1.55vw, 1.4rem); line-height: 1.55; letter-spacing: -.025em; }
	.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.75rem; margin-top: 2.25rem; }
	.hero-visual { min-width: 0; width: 100%; max-width: 560px; justify-self: end; }
	.hero-foot { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.5rem; border-top: 1px solid var(--line); font: .61rem/1.5 var(--mono); letter-spacing: .035em; text-transform: uppercase; color: var(--muted); }
	.hero-foot > div { display: flex; gap: 3rem; }
	.hero-foot > a { display: grid; place-items: center; width: 44px; height: 44px; margin-block: -.75rem; font-size: 1.1rem; color: var(--ink); }
	.about { border-top: 0; }
	.about-copy { display: grid; grid-template-columns: .55fr 1.7fr; gap: 3rem; align-items: start; }
	.about-copy > .eyebrow { padding-top: .5rem; }
	.about-copy h2 { margin: 0; font-size: clamp(2rem, 3.35vw, 3.25rem); line-height: 1.18; letter-spacing: -.045em; font-weight: 450; }
	.about-copy em { color: var(--acid-deep); }
	.about-detail { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 2rem; }
	.about-detail p { margin: 0; color: var(--muted); font-size: .95rem; }
	.lab-facts { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); }
	.lab-facts strong { display: block; font-size: clamp(1.6rem, 2.5vw, 2.35rem); font-weight: 450; letter-spacing: -.045em; line-height: 1.2; }
	.lab-facts span { display: block; margin-top: .5rem; color: var(--muted); font-size: .75rem; }
	.worlds { background: var(--paper-soft); }
	.project-grid { gap: 1.5rem; }
	.section-head { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-bottom: 2.75rem; }
	.section-head .eyebrow { margin-bottom: 1rem; }
	.section-head h2, .institution-intro { font-size: clamp(2.1rem, 3.5vw, 3.25rem); }
	.all-link { white-space: nowrap; }
	.institutions { background: var(--paper-soft); }
	.institution-intro { margin: 0 0 2.75rem; line-height: 1.1; letter-spacing: -.045em; font-weight: 450; }
	.institution-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
	.institution-grid a { min-height: 11rem; padding: .25rem 1.75rem; border-left: 1px solid var(--line); display: flex; flex-direction: column; justify-content: space-between; transition: color .2s ease; }
	.institution-grid a:first-child { padding-left: 0; border-left: 0; }
	.institution-grid a:hover { color: var(--acid-deep); }
	.institution-grid span { font: .58rem/1.5 var(--mono); text-transform: uppercase; color: var(--muted); }
	.institution-grid .arrow { align-self: flex-end; font-size: 1rem; }
	.institution-grid strong { font-size: clamp(1.1rem, 1.6vw, 1.5rem); line-height: 1.25; letter-spacing: -.03em; font-weight: 450; }
	@media (min-width: 1600px) { .hero { min-height: 740px; } }
	@media (max-width: 1000px) {
		.hero { min-height: 560px; gap: 1rem; }
		.hero-actions { gap: 1rem; }
		.hero-foot > div { gap: 1.5rem; }
		.about-copy { grid-template-columns: .45fr 1.7fr; gap: 2rem; }
	}
	@media (max-width: 760px) {
		.hero { min-height: auto; grid-template-columns: 1fr; padding-top: 3.5rem; padding-bottom: 2.5rem; gap: 2.5rem; }
		.hero h1 { font-size: clamp(2.8rem, 9.5vw, 4.75rem); }
		.hero .eyebrow { margin-bottom: 1.5rem; font-size: .57rem; }
		.hero-visual { max-width: 390px; justify-self: center; }
		.hero-foot > span { display: none; }
		.hero-foot > div { gap: 1rem; font-size: .52rem; }
		.about-copy { grid-template-columns: 1fr; gap: 1rem; }
		.about-detail { grid-template-columns: 1fr; gap: 1rem; }
		.lab-facts { gap: 1rem; }
		.lab-facts span { font-size: .67rem; }
		.project-grid { gap: 1.5rem; }
	.section-head { align-items: start; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
		.institution-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem 0; }
		.institution-grid a { padding: 0 1rem; min-height: 10rem; }
		.institution-grid a:nth-child(odd) { padding-left: 0; border-left: 0; }
	}
	@media (max-width: 360px) { .hero-actions { flex-direction: column; align-items: flex-start; } .desktop-break { display: none; } }
</style>
