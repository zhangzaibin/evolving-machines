---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectFeature from '../components/ProjectFeature.astro';

const projectOrder = ['oasis', 'spagent', 'future'];
const allProjects = await getCollection('projects');
const projects = projectOrder.map((id) => allProjects.find((project) => project.id === id)!).filter(Boolean);
---

<BaseLayout title="Projects" description="OASIS, SPAgent, and Future—three open-source projects spanning the digital and physical worlds.">
	<header class="page-hero shell">
		<p class="eyebrow">Three open projects</p>
		<h1 class="display">One lab.<br /><em>Two worlds.</em></h1>
		<p class="lede">OASIS provides a digital environment for evolving agent societies. SPAgent and Future move the same learning loop into spatial reasoning and physical action through tools, policies, benchmarks, and hardware.</p>
	</header>

	<section class="section">
		<div class="shell">
			<p class="eyebrow">OASIS / SPAgent / Future</p>
			<div class="projects-list">
				{projects.map((project, index) => (
					<div id={project.id}><ProjectFeature project={project.data} index={index + 1} /></div>
				))}
			</div>
		</div>
	</section>

	<section class="section open-call">
		<div class="shell grid-2">
			<h2>Open by<br />default.</h2>
			<div>
				<p>We believe important agent infrastructure should be inspectable, extensible, and useful beyond a single paper. Our projects connect research artifacts to real communities of researchers and builders.</p>
				<a href="https://github.com/zhangzaibin">Explore our GitHub <span class="arrow">↗</span></a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero em { font-family: var(--serif); font-weight: 400; }
	.projects-list > div { scroll-margin-top: 110px; }
	.projects-list > div + div { margin-top: 2rem; }
	.open-call { background: var(--acid); }
	.open-call .grid-2 { gap: clamp(3rem, 10vw, 12rem); }
	.open-call h2 { margin: 0; font-size: clamp(3.5rem, 6.5vw, 6.5rem); line-height: .88; letter-spacing: -.06em; font-weight: 500; }
	.open-call p { max-width: 39rem; font-size: 1.15rem; letter-spacing: -.02em; }
	.open-call a { display: inline-block; margin-top: 2rem; padding-bottom: .4rem; border-bottom: 1px solid; font: .68rem var(--mono); text-transform: uppercase; }
</style>
